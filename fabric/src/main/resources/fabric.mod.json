{
  "schemaVersion": 1,
  "id": "accelerate",
  "version": "${version}",
  "name": "Create: Accelerate",
  "description": "Create: Accelerate is an addon for create that adds many high-speed rail features, including a new type of rail, maglev, which allows for higher speeds than normal tracks.",
  "authors": [
    "CircuitScout",
    "BlahajTheShark14"
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/create-accelerate",
    "issues": "https://github.com/Coppergrid/accelerate/issues",
    "sources": "https://github.com/Coppergrid/accelerate"
  },
  "license": "AGPL-3.0",
  "icon": "assets/accelerate/acceleratelogo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "coppergrid.accelerate.fabric.AccelerateFabric"
    ],
    "fabric-datagen": [
      "coppergrid.accelerate.fabric.DataGenEntry"
    ]
  },
  "mixins": [
    "accelerate.mixins.json",
    "accelerate-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": ">=${create_version} <6.1.0"
  }
}