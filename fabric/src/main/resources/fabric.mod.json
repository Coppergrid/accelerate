{
  "schemaVersion": 1,
  "id": "accelerate",
  "version": "${version}",
  "name": "Create: Accelerate",
  "description": "Create: Accelerate is an addon for create that adds many high-speed rail features, including a new type of rail, maglev, which allows for higher speeds than normal tracks.",
  "authors": [
    "OneLink",
    "BlahajTheShark14"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/OneLinkPog/highspeed"
  },
  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/accelerate/acceleratelogo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "onelink.accelerate.fabric.AccelerateFabric"
    ]
  },
  "mixins": [
    "accelerate.mixins.json",
    "accelerate-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}"
  }
}