{
  "schemaVersion": 1,
  "id": "highspeed",
  "version": "${version}",
  "name": "Create: Highspeed",
  "description": "Create: Highspeed is an addon for create that adds many high-speed rail features, including a new type of rail, maglev, which allows for higher speeds than normal tracks.",
  "authors": [
    "OneLink"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/OneLinkPog/highspeed"
  },
  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/highspeed/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "onelink.highspeed.fabric.HighSpeedFabric"
    ]
  },
  "mixins": [
    "highspeed.mixins.json",
    "highspeed-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}"
  }
}