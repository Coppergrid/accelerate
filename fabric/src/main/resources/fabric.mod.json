{
  "schemaVersion": 1,
  "id": "createmaglev",
  "version": "${version}",
  "name": "Create: Maglev",
  "description": "Create: Maglev is an addon for create that adds a new type of rail, maglev, which allows for higher speeds than normal tracks.",
  "authors": [
    "OneLink"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC BY-NC-SA 4.0",
  "icon": "assets/createmaglev/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "onelink.createmaglev.fabric.CreateMaglevFabric"
    ]
  },
  "mixins": [
    "createmaglev.mixins.json",
    "createmaglev-common.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "create": "${create_version}"
  }
}